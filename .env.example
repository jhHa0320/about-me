# Django Settings
SECRET_KEY=change-me-in-production-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# PythonAnywhere 자동화 (scripts/fetch_pythonanywhere.py, scripts/deploy_pythonanywhere.py)
# 토큰 발급: https://www.pythonanywhere.com/account/#api_token
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다. 절대 코드에 직접 넣지 마세요.
PA_USERNAME=your_username
PA_TOKEN=your_api_token
# EU 계정이면 eu.pythonanywhere.com
# PA_HOST=www.pythonanywhere.com
# 비우면 manage.py 가 있는 폴더를 자동으로 찾습니다
# PA_REMOTE_DIR=/home/your_username/about_me
# 비우면 {PA_USERNAME}.pythonanywhere.com 을 씁니다
# PA_DOMAIN=your_username.pythonanywhere.com

# Database (Optional - defaults to SQLite if not set)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432
